include_guard(GLOBAL)
get_filename_component(strDependencyRoot "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
option(WENKU8_BUNDLED_CURL "Build bundled curl source" ${WIN32})
if(WENKU8_BUNDLED_CURL)
    # Rebuild the provided archive instead of relying on untracked OpenSSL DLLs
    # or the toolset/runtime ABI of the old prebuilt .lib files.
    file(SHA256 "${strDependencyRoot}/third_party/curl-8.0.1.zip" curl_sha)
    if(NOT curl_sha STREQUAL "9298ef7bfa305c4ea36752a7d44b7aa63aa3074650ab03abad0fe2d7225e514c")
        message(FATAL_ERROR "The supplied curl archive has changed; review its source and license")
    endif()
    set(curl_source "${CMAKE_CURRENT_BINARY_DIR}/_deps/curl-8.0.1")
    if(NOT EXISTS "${curl_source}/CMakeLists.txt")
        file(ARCHIVE_EXTRACT INPUT "${strDependencyRoot}/third_party/curl-8.0.1.zip"
             DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/_deps")
    endif()
    set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
    set(BUILD_CURL_EXE OFF CACHE BOOL "" FORCE)
    set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
    set(HTTP_ONLY ON CACHE BOOL "" FORCE)
    set(CURL_USE_LIBPSL OFF CACHE BOOL "" FORCE)
    set(CURL_USE_LIBSSH2 OFF CACHE BOOL "" FORCE)
    set(USE_LIBIDN2 OFF CACHE BOOL "" FORCE)
    set(CMAKE_DISABLE_FIND_PACKAGE_ZLIB ON)
    set(CURL_ENABLE_EXPORT_TARGET OFF CACHE BOOL "" FORCE)
    if(WIN32)
        set(CURL_USE_SCHANNEL ON CACHE BOOL "" FORCE)
        set(CURL_USE_OPENSSL OFF CACHE BOOL "" FORCE)
    endif()
    add_subdirectory("${curl_source}" "${CMAKE_CURRENT_BINARY_DIR}/_deps/curl-build" EXCLUDE_FROM_ALL)
else()
    # Some curl 8 config packages declare same-major version compatibility and
    # reject a 7.85 minimum. Prefer their exported target so static TLS
    # dependencies survive cross-compilation, then enforce our real minimum.
    find_package(CURL CONFIG QUIET)
    if(CURL_FOUND)
        if(CURL_VERSION VERSION_LESS 7.85)
            message(FATAL_ERROR "curl >=7.85 is required")
        endif()
    else()
        find_package(CURL 7.85 REQUIRED)
    endif()
endif()

add_library(wenku8_xml STATIC "${strDependencyRoot}/third_party/tinyxml2/tinyxml2.cpp")
target_include_directories(wenku8_xml PUBLIC "${strDependencyRoot}/third_party/tinyxml2")
set_target_properties(wenku8_xml PROPERTIES POSITION_INDEPENDENT_CODE ON)
file(SHA256 "${strDependencyRoot}/third_party/libxml2-2.15.4.tar.xz" html_sha)
if(NOT html_sha STREQUAL "98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821")
    message(FATAL_ERROR "libxml2 archive changed; review source and license")
endif()
set(html_source "${CMAKE_CURRENT_BINARY_DIR}/_deps/libxml2-2.15.4")
if(NOT EXISTS "${html_source}/CMakeLists.txt")
    file(ARCHIVE_EXTRACT INPUT "${strDependencyRoot}/third_party/libxml2-2.15.4.tar.xz" DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/_deps")
endif()
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
foreach(feature ICONV ICU PROGRAMS PYTHON TESTS MODULES ZLIB CATALOG VALID XINCLUDE SCHEMAS RELAXNG SCHEMATRON)
    set(LIBXML2_WITH_${feature} OFF CACHE BOOL "" FORCE)
endforeach()
set(LIBXML2_WITH_HTML ON CACHE BOOL "" FORCE)
set(LIBXML2_WITH_XPATH ON CACHE BOOL "" FORCE)
add_subdirectory("${html_source}" "${CMAKE_CURRENT_BINARY_DIR}/_deps/libxml2-build" EXCLUDE_FROM_ALL)
set_target_properties(LibXml2 PROPERTIES POSITION_INDEPENDENT_CODE ON)

